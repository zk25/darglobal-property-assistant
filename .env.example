# Copy this file to .env and fill in your own key. Never commit .env.
OPENROUTER_API_KEY=

# Comma-separated model ids, tried in order. Empty = the defaults in app/main.py.
OPENROUTER_MODELS=

# Sent to OpenRouter as the referer (your site address).
APP_URL=

# Chat messages allowed per minute: per visitor, and for all visitors together.
RATE_LIMIT_PER_MIN=15
GLOBAL_LIMIT_PER_MIN=60

# 0 = curated knowledge base only (more accurate). 1 = also load data/scraped/.
INCLUDE_SCRAPED=0

PORT=7860
